# Configuration du Backend Meet Me

# Serveur
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081

# Base de données Supabase (Postgres)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-eu-west-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxx
DB_PASSWORD=votre_mot_de_passe
# Database Test (Postgres)
# DATABASE_URL_TEST=postgres://...

# JWT Authentication
JWT_SECRET=votre_jwt_secret_super_securise_ici
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=votre_refresh_secret_ici
JWT_REFRESH_EXPIRE=30d

# APIs de Traduction
GOOGLE_TRANSLATE_API_KEY=votre_cle_google_translate_ici
DEEPL_API_KEY=votre_cle_deepl_ici
TRANSLATION_PROVIDER=google # google ou deepl

# Agora Configuration (pour les appels)
AGORA_APP_ID=votre_agora_app_id_ici
AGORA_APP_CERTIFICATE=votre_agora_certificate_ici

# AWS S3 Configuration (pour le stockage des fichiers)
AWS_ACCESS_KEY_ID=votre_access_key_aws_ici
AWS_SECRET_ACCESS_KEY=votre_secret_key_aws_ici
AWS_REGION=eu-west-3
AWS_S3_BUCKET=votre_bucket_s3_ici
AWS_S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com

# Firebase Configuration (pour les notifications)
FIREBASE_PROJECT_ID=votre_project_id_firebase_ici
FIREBASE_PRIVATE_KEY=votre_private_key_firebase_ici
FIREBASE_CLIENT_EMAIL=votre_client_email_firebase_ici

# Email Configuration (pour la récupération de mot de passe)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_app_gmail
EMAIL_FROM=noreply@meetme.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=50 * 1024 * 1024 # 50MB
MAX_AUDIO_DURATION=300 # 5 minutes en secondes

# Logging
LOG_LEVEL=info
LOG_FILE=logs/meetme.log

# Socket.IO
SOCKET_PING_TIMEOUT=5000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_HTTP_BUFFER_SIZE=1e6

# Notes:
# 1. Créez un fichier .env à partir de ce template
# 2. Remplissez les valeurs avec vos propres configurations
# 3. Pour la base de données: utilisez Supabase (Postgres)
# 4. Pour AWS S3: créez un bucket S3 et obtenez vos credentials
# 5. Pour Firebase: créez un projet Firebase et téléchargez la clé de service
# 6. Ne commitez jamais le fichier .env réel dans Git