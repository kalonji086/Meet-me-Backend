# ============================================
# CONFIGURATION AGORA POUR PRODUCTION
# ============================================

# 1. OBTENIR VOS CRÉDENTIALS AGORA
# ---------------------------------
# 1. Allez sur https://console.agora.io/
# 2. Créez un compte gratuit
# 3. Créez un projet "Meet Me"
# 4. Dans "Project Management" > "Edit"
# 5. Copiez "App ID" et "App Certificate"

# App ID Agora (obligatoire pour les appels)
AGORA_APP_ID=votre_app_id_agora_ici

# App Certificate Agora (obligatoire pour les tokens)
AGORA_APP_CERTIFICATE=votre_app_certificate_agora_ici

# ============================================
# CONFIGURATION DE BASE
# ============================================

# Port du serveur
PORT=3000

# Environnement
NODE_ENV=production

# CORS Origin (URL de votre frontend)
CORS_ORIGIN=https://votre-frontend.com

# ============================================
# BASE DE DONNÉES
# ============================================

# URL de connexion PostgreSQL (Supabase)
DATABASE_URL=postgresql://username:password@host:port/database

# Ou configuration séparée
DB_HOST=aws-1-eu-west-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.jpddrhqpzydjugwhgddr
DB_PASSWORD=votre_mot_de_passe_supabase

# Supabase
SUPABASE_URL=https://votre-project.supabase.co
SUPABASE_KEY=votre_supabase_anon_key
SUPABASE_ANON_KEY=votre_supabase_anon_key

# ============================================
# JWT & AUTHENTIFICATION
# ============================================

# Clés JWT (CHANGER EN PRODUCTION!)
JWT_SECRET=votre_jwt_secret_super_securise_ici
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=votre_refresh_secret_super_securise_ici
JWT_REFRESH_EXPIRE=30d

# ============================================
# STOCKAGE FICHIERS
# ============================================

# AWS S3 pour le stockage des fichiers
AWS_ACCESS_KEY_ID=votre_aws_access_key
AWS_SECRET_ACCESS_KEY=votre_aws_secret_key
AWS_REGION=eu-west-3
AWS_S3_BUCKET=votre-bucket-s3

# ============================================
# EMAIL & NOTIFICATIONS
# ============================================

# SMTP pour les emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_app_gmail

# Brevo (Sendinblue) pour les emails transactionnels
BREVO_API_KEY=votre_api_key_brevo

# ============================================
# TRADUCTION
# ============================================

# Google Translate API
GOOGLE_TRANSLATE_API_KEY=votre_google_translate_api_key

# DeepL API (optionnel)
DEEPL_API_KEY=votre_deepl_api_key

# ============================================
# FIREBASE (PUSH NOTIFICATIONS)
# ============================================

FIREBASE_PROJECT_ID=votre_project_id_firebase
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nvotre_private_key\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@votre-project.iam.gserviceaccount.com

# ============================================
# SÉCURITÉ
# ============================================

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # 100 requêtes par 15 minutes

# Taille max des fichiers (en bytes)
MAX_FILE_SIZE=52428800  # 50MB

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=info
LOG_FILE=logs/meetme.log

# ============================================
# NOTES IMPORTANTES
# ============================================

# 1. AGORA: Obligatoire pour les appels audio/vidéo
# 2. AWS S3: Obligatoire pour le stockage des fichiers
# 3. JWT: CHANGER les secrets en production!
# 4. DATABASE: Configurer votre base de données
# 5. EMAIL: Configurer pour les notifications

# Pour générer un JWT secret sécurisé:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Pour tester la configuration:
# 1. Copier ce fichier en .env
# 2. Remplir les valeurs
# 3. Lancer: npm run config:check